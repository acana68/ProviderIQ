# Copy to .env at the repo root for local development. Never commit the real .env.
ENVIRONMENT=dev

# Postgres (docker-compose.yml passes the POSTGRES_* vars to the db container).
# Host port 5433 (not 5432) avoids clashing with a natively installed Postgres.
# The password must match in all three places: POSTGRES_PASSWORD, DATABASE_URL, TEST_DATABASE_URL.
POSTGRES_USER=provideriq
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=provideriq
DATABASE_URL=postgresql+psycopg://provideriq:change-me-locally@localhost:5433/provideriq
TEST_DATABASE_URL=postgresql+psycopg://provideriq:change-me-locally@localhost:5433/provideriq_test
