# Copy to .env at the repo root for local development. Never commit the real .env.
# dev, test or prod. prod turns off /docs, /redoc and /openapi.json, and refuses to reseed.
ENVIRONMENT=dev

# Postgres (docker-compose.yml passes only the POSTGRES_* vars to the db container).
# Host port 5433 (not 5432) avoids clashing with a natively installed Postgres; Compose
# publishes it on 127.0.0.1 only.
#
# Two roles:
# - the owner (POSTGRES_USER): migrations, seeding, the CMS pipeline, the test suite.
#   Its password must match in POSTGRES_PASSWORD, MIGRATION_DATABASE_URL, TEST_DATABASE_URL.
# - the runtime role, provideriq_app: what the API connects as. It can read, and add
#   search_logs rows, nothing else. The migrations create it; `python -m scripts.app_db_role`
#   (run by the Docker entrypoint) lets it log in with APP_DB_PASSWORD, which must match
#   the password in DATABASE_URL.
# Keep both passwords URL-safe (no @ : / ? #).
POSTGRES_USER=provideriq
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=provideriq
APP_DB_PASSWORD=change-me-too-locally
DATABASE_URL=postgresql+psycopg://provideriq_app:change-me-too-locally@localhost:5433/provideriq
MIGRATION_DATABASE_URL=postgresql+psycopg://provideriq:change-me-locally@localhost:5433/provideriq
TEST_DATABASE_URL=postgresql+psycopg://provideriq:change-me-locally@localhost:5433/provideriq_test

# Which dataset scripts/seed_db.py loads: "synthetic" (generated providers) or "cms_nj"
# (real public CMS data for New Jersey, from data/cms/). Tests always use synthetic data.
DATA_SOURCE=synthetic

# Logging: DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout.
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated, no trailing slashes).
CORS_ORIGINS=http://localhost:5173

# Requests with a larger body are rejected with 413.
MAX_REQUEST_BODY_BYTES=65536

# Per client IP, per app process. /health/live is exempt.
RATE_LIMIT_PER_MINUTE=120

# AI query parsing (POST /api/v1/ai/parse-query).
# "none": built-in keyword parser, no key needed. "anthropic": Claude, with the keyword
# parser as automatic fallback on any error.
AI_PROVIDER=none
# Only used when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# The most one parse waits for the model (no retries); then it falls back to keywords.
AI_TIMEOUT_SECONDS=8
# Per client IP, on the AI endpoint only, on top of RATE_LIMIT_PER_MINUTE.
AI_RATE_LIMIT_PER_MINUTE=10
